<% comment = local_assigns.fetch(:comment) { Comment.new } %>
<% field_id = comment.persisted? ? "comment-edit-#{comment.id}" : "comment-form-#{post.id}" %>
<div class="comment-input comment-<%= post.id %>">
  <%= form_with model: [post, comment], local: false, class: 'note-form' do |f| %>
    <%= f.label :comment_body, comment.persisted? ? 'Edit note' : 'Add a note', for: field_id, class: 'visually-hidden' %>
    <%= f.text_field :comment_body, id: field_id, placeholder: 'Add a note…', required: true, maxlength: 500, autocomplete: 'off' %>
    <%= f.submit comment.persisted? ? 'Save' : 'Post', class: 'button button-small', data: { disable_with: '…' } %>
  <% end %>
</div>
