<% if post.comments.empty? %>
  <p class="muted small">No notes yet.</p>
<% else %>
  <ul class="notes">
    <% post.comments.each do |comment| %>
      <li class="note">
        <p>
          <%= link_to comment.user.username, profile_path(comment.user.username), class: 'note-author' %>
          <span id="comment-<%= comment.id %>"><%= comment.comment_body %></span>
        </p>
        <div class="note-meta">
          <time datetime="<%= comment.created_at.iso8601 %>"><%= time_ago_in_words(comment.created_at) %> ago</time>
          <% if can_edit_comment?(comment) %>
            <%= link_to 'Edit', edit_post_comment_path(post, comment), remote: true, class: 'small' %>
          <% end %>
          <% if can_delete_comment?(comment) %>
            <%= button_to 'Delete', post_comment_path(post, comment), method: :delete, class: 'link-button small danger',
                                                                     form: { 'data-remote': 'true' } %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
