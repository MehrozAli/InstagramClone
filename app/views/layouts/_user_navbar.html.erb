<header class="topbar">
  <%= render 'layouts/brand' %>
  <%= form_tag search_path, method: :get, class: 'search', role: 'search' do %>
    <%= label_tag :search, 'Search people', class: 'visually-hidden' %>
    <%= search_field_tag :search, params[:search], placeholder: 'Search people' %>
    <button type="submit" class="icon-button" aria-label="Search"><%= icon(:search) %></button>
  <% end %>
  <nav aria-label="Main" class="topbar-links">
    <%= link_to 'Feed', home_path, aria: { current: (current_page?(home_path) ? 'page' : nil) } %>
    <%= link_to 'New photo', new_post_path %>
    <%= link_to 'Profile', profile_path(current_user.username) %>
    <%= button_to 'Log out', destroy_user_session_path, method: :delete, class: 'link-button' %>
  </nav>
</header>
