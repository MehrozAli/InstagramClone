<% content_for :title, 'Edit profile' %>
<section class="narrow card">
  <h1>Edit profile</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true, class: 'stack-form' }) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %>

    <div class="field">
      <%= f.label :profileImg, 'Profile picture (PNG or JPEG)' %>
      <%= f.file_field :profileImg, accept: 'image/png,image/jpeg' %>
      <%= f.hidden_field :profileImg_cache %>
    </div>

    <div class="field">
      <%= f.label :username %>
      <%= f.text_field :username, required: true, maxlength: 20, autocomplete: 'username' %>
    </div>

    <div class="field-row">
      <div class="field">
        <%= f.label :first_name %>
        <%= f.text_field :first_name, required: true, maxlength: 20 %>
      </div>
      <div class="field">
        <%= f.label :last_name %>
        <%= f.text_field :last_name, maxlength: 20 %>
      </div>
    </div>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, required: true, autocomplete: 'email' %>
    </div>

    <div class="field field-inline">
      <%= f.check_box :isPrivate %>
      <%= f.label :isPrivate, 'Private account: only followers can open my photos' %>
    </div>

    <fieldset class="field-group">
      <legend>Change password <span class="muted">(leave blank to keep it)</span></legend>
      <div class="field">
        <%= f.label :password, 'New password' %>
        <%= f.password_field :password, autocomplete: 'new-password' %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, 'Confirm new password' %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
      </div>
    </fieldset>

    <div class="field">
      <%= f.label :current_password %>
      <%= f.password_field :current_password, autocomplete: 'current-password', required: true, aria: { describedby: 'current-hint' } %>
      <p class="hint" id="current-hint">Needed to confirm any change.</p>
    </div>

    <%= f.submit 'Save changes', class: 'button' %>
  <% end %>

  <div class="danger-zone">
    <h2>Delete account</h2>
    <p class="muted">Removes your photos, notes, likes and follows.</p>
    <%= button_to 'Delete my account', registration_path(resource_name), method: :delete,
                                                                         class: 'button button-danger', data: { confirm: 'Delete your account and all your photos?' } %>
  </div>
</section>
