<% if @recommended.any? %>
  <ul class="people">
    <% @recommended.each do |user| %>
      <li class="person">
        <%= link_to profile_path(user.username), class: 'person-link' do %>
          <%= image_tag render_profile_picture(user.profileImg), size: '40x40', class: 'avatar', alt: '' %>
          <span>
            <span class="person-name"><%= user.full_name %></span>
            <span class="muted">@<%= user.username %></span>
          </span>
        <% end %>
        <%= button_to 'Follow', follow_user_path, params: { follow_id: user.id }, class: 'button button-small',
                                                  aria: { label: "Follow #{user.full_name}" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="muted">You already follow everyone here.</p>
<% end %>
