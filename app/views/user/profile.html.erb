<% content_for :title, @user.full_name %>
<section class="profile">
  <header class="profile-head">
    <%= image_tag render_profile_picture(@user.profileImg), class: 'avatar avatar-large', alt: "Profile picture of #{@user.full_name}" %>
    <div class="profile-meta">
      <h1><%= @user.full_name %></h1>
      <p class="muted">@<%= @user.username %><%= ' · private account' if @user.isPrivate %></p>
      <ul class="stats">
        <li><strong><%= @user_posts.size %></strong> <%= 'photo'.pluralize(@user_posts.size) %></li>
        <li><strong><%= @user.total_followers %></strong> <%= 'follower'.pluralize(@user.total_followers) %></li>
        <li><strong><%= @user.total_following %></strong> following</li>
      </ul>
      <% if can_edit_profile?(@user.id) %>
        <%= link_to 'Edit profile', edit_user_registration_path, class: 'button button-quiet button-small' %>
      <% elsif current_user.following?(@user.id) %>
        <%= button_to 'Unfollow', unfollow_user_path, params: { follow_id: @user.id }, class: 'button button-quiet button-small' %>
      <% else %>
        <%= button_to 'Follow', follow_user_path, params: { follow_id: @user.id }, class: 'button button-small' %>
      <% end %>
    </div>
  </header>

  <h2 class="section-title">Contact sheet</h2>
  <% if private?(@user) %>
    <div class="empty-state">
      <h3>This account is private</h3>
      <p>Follow <%= @user.first_name %> to see their photos.</p>
    </div>
  <% elsif @user_posts.empty? %>
    <div class="empty-state">
      <h3>No photos yet</h3>
      <p><%= can_edit_profile?(@user.id) ? 'Your first photo will show up here.' : "#{@user.first_name} hasn't posted anything yet." %></p>
    </div>
  <% else %>
    <ol class="contact-sheet">
      <% @user_posts.each_with_index do |post, i| %>
        <li>
          <%= link_to post_path(post) do %>
            <%= image_tag post.image_url, alt: "Photo #{i + 1} by #{@user.full_name}" %>
            <span class="frame-no" aria-hidden="true"><%= format('%02d', i + 1) %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
