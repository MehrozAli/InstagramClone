<% if @stories.any? %>
  <ul class="stories">
    <% @stories.each do |story| %>
      <li>
        <%= link_to post_path(story) do %>
          <%= image_tag story.image_url, alt: "Story from #{story.user.full_name}", class: 'story-thumb' %>
          <span><%= story.user.username %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="muted">No stories right now. Stories disappear a day after they are posted.</p>
<% end %>
