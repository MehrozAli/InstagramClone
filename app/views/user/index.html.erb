<% content_for :title, 'Feed' %>
<div class="feed-layout">
  <section class="feed" aria-labelledby="feed-heading">
    <h1 id="feed-heading" class="visually-hidden">Your feed</h1>
    <div class="alert-box" aria-live="polite"></div>

    <% if @posts.any? %>
      <%= render partial: 'posts/post', collection: @posts, as: :post %>
    <% else %>
      <div class="empty-state">
        <h2>Your feed is empty</h2>
        <p>Follow someone from the suggestions, or post your first photo.</p>
        <%= link_to 'Post a photo', new_post_path, class: 'button' %>
      </div>
    <% end %>
  </section>

  <aside class="sidebar" aria-label="People and stories">
    <div class="me">
      <%= image_tag render_profile_picture(current_user.profileImg), size: '56x56', class: 'avatar', alt: '' %>
      <div>
        <p class="me-name"><%= current_user.full_name %></p>
        <p class="muted">@<%= current_user.username %></p>
      </div>
    </div>

    <section class="panel" aria-labelledby="stories-heading">
      <div class="panel-head">
        <h2 id="stories-heading">Stories</h2>
        <%= link_to 'Add a story', story_path %>
      </div>
      <%= render 'stories' %>
    </section>

    <section class="panel" aria-labelledby="suggestions-heading">
      <div class="panel-head">
        <h2 id="suggestions-heading">People to follow</h2>
      </div>
      <%= render 'recommended_users' %>
    </section>
  </aside>
</div>
