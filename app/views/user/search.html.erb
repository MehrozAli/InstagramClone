<% content_for :title, 'Search' %>
<section class="search-results">
  <h1>People matching “<%= params[:search] %>”</h1>
  <% if @results.empty? %>
    <div class="empty-state">
      <p>Nobody matches that. Try part of a username or a first name.</p>
    </div>
  <% else %>
    <ul class="people people-wide">
      <% @results.each do |result| %>
        <li class="person">
          <%= link_to profile_path(result.username), class: 'person-link' do %>
            <%= image_tag render_profile_picture(result.profileImg), size: '48x48', class: 'avatar', alt: '' %>
            <span>
              <span class="person-name"><%= result.full_name %></span>
              <span class="muted">@<%= result.username %></span>
            </span>
          <% end %>
          <% if current_user.id == result.id %>
            <span class="tag">You</span>
          <% elsif current_user.following?(result.id) %>
            <%= button_to 'Unfollow', unfollow_user_path, params: { follow_id: result.id }, class: 'button button-quiet button-small' %>
          <% else %>
            <%= button_to 'Follow', follow_user_path, params: { follow_id: result.id }, class: 'button button-small' %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
