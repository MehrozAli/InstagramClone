<%= form_with model: @post, html: { multipart: true, class: 'stack-form' } do |f| %>
  <% if @post.errors.any? %>
    <div class="form-errors" role="alert">
      <% @post.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>
  <div class="field">
    <%= f.label :image, 'Photo (PNG or JPEG, up to 10 MB)' %>
    <%= f.file_field :image, required: true, accept: 'image/png,image/jpeg' %>
  </div>
  <%= f.hidden_field :image_cache %>
  <%= f.hidden_field :post_type, value: @post.post_type %>
  <%= f.submit submit_label, class: 'button', data: { disable_with: 'Uploading…' } %>
<% end %>
