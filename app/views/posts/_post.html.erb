<article class="print" aria-labelledby="post-<%= post.id %>-author">
  <header class="print-head">
    <%= link_to profile_path(post.user.username), class: 'person-link', id: "post-#{post.id}-author" do %>
      <%= image_tag render_profile_picture(post.user.profileImg), size: '36x36', class: 'avatar', alt: '' %>
      <span class="person-name"><%= post.post_user %></span>
    <% end %>
    <%= render 'posts/owner_actions', post: post if can_alter_post?(post) %>
  </header>

  <%= link_to post_path(post), class: 'print-photo' do %>
    <%= image_tag post.image_url, alt: "Photo by #{post.post_user}", loading: 'lazy' %>
  <% end %>

  <div class="print-body">
    <%= render 'posts/actions', post: post %>
    <p class="muted small"><time datetime="<%= post.created_at.iso8601 %>"><%= time_ago_in_words(post.created_at) %> ago</time></p>

    <div class="comments-box" id="comments-<%= post.id %>">
      <%= render 'comments/comments', post: post %>
    </div>
    <%= render 'comments/comment_box', post: post %>
  </div>
</article>
