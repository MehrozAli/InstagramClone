# Copy to .env and replace the placeholder values before the first run.

# Postgres role used by the app and created by the db container.
DATABASE_USERNAME=pinhole
DATABASE_PASSWORD=replace-with-a-local-password

# Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=replace-with-a-long-random-string

# Host port for the web container.
PORT=3000

# Keep false for plain-HTTP localhost; true behind a TLS proxy.
RAILS_FORCE_SSL=false

# How long a story stays visible (minutes). 1440 = one day.
STORY_LIFETIME_MINUTES=1440
